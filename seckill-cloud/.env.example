# Copy this file to .env and replace every production secret before deployment.
# Use docker.1ms.run when Docker Hub is unreachable from the deployment host.
DOCKER_REGISTRY=docker.io

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_USERNAME=seckill
MYSQL_PASSWORD=replace-with-a-strong-database-password

RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password

MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=replace-with-a-strong-minio-password
# This URL is returned to browsers. Replace localhost with the deployment host.
MINIO_PUBLIC_URL=http://localhost:9010

INTERNAL_TOKEN=replace-with-a-long-random-internal-token
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

FRONTEND_PORT=80
GATEWAY_PORT=8080
AI_SERVICE_PORT=8200
