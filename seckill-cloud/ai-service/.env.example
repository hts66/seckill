DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_SERVICE_PORT=8200
INTERNAL_TOKEN=
ORDER_SERVICE_URL=http://localhost:8104
PRODUCT_SERVICE_URL=http://localhost:8102
ACTIVITY_SERVICE_URL=http://localhost:8103
REDIS_URL=redis://localhost:6380/2
CONVERSATION_TTL_SECONDS=86400
AI_MAX_HISTORY=12

# --- Knowledge base + RAG retrieval ---
KNOWLEDGE_FILE=app/faq.json
INDEX_CACHE_DIR=.rag_cache
RAG_TOP_K=3
RAG_MIN_SCORE=0.45
# local = sentence-transformers (offline); openai = any OpenAI-compatible embedding API
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-small

# --- Observability ---
LOG_LEVEL=INFO
# Optional LangSmith tracing (leave disabled if you have no key)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=seckill-ai-customer-service
